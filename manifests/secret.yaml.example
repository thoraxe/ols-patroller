# In-cluster deployment (#2) — TEMPLATE for the patrol Secret.
# Contract: .ai/spec/what/in-cluster-deployment.md rules 14-15.
#
# Procedure (rule 14): copy this file to secret.yaml, fill in the real
# values, then `oc apply -k manifests/`. secret.yaml is GITIGNORED — real
# credentials are never committed; the kustomization lists it, so the apply
# fails loudly until the operator creates it.
apiVersion: v1
kind: Secret
metadata:
  name: ols-patroller
  namespace: ols-patroller
stringData:
  # Required — the OpenAI-compatible endpoint the patrol model runs on
  # (system-overview.md rule 6 startup env check):
  PATROL_API_KEY: "<your-api-key>"
  PATROL_BASE_URL: "<your-base-url e.g. https://api.example.com/v1>"
  PATROL_MODEL: "<your-model-id>"
  # Optional — uncomment to enable:
  # SLACK_WEBHOOK_URL: "<your-slack-webhook-url>"
  # PATROL_WIKI_REMOTE: "<git-remote-to-replicate-the-wiki-to>"
